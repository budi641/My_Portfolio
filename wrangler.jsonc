{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ameen-games",
  "account_id": "b71bb247b91d54baa0716e67520a503e",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": true,
